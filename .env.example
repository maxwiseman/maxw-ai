# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# The database URL is used to connect to your Supabase database.
DATABASE_URL="libsql://[DB-NAME].aws-us-east-1.turso.io"
DATABASE_AUTH_TOKEN=""

# Autopilot creates one named Vercel Sandbox per active run. Generate this
# independently from AUTH_SECRET with: openssl rand -base64 32
AUTOPILOT_WORKER_SECRET=""
AUTOPILOT_SANDBOX_REPO_URL="https://github.com/maxwiseman/maxw-ai.git"
AUTOPILOT_SANDBOX_REPO_REF="master"
AUTOPILOT_SANDBOX_VCPUS="4"

# Only needed when the repository is private. A fine-grained GitHub token can
# be used as the password with x-access-token as the username.
AUTOPILOT_SANDBOX_REPO_USERNAME=""
AUTOPILOT_SANDBOX_REPO_PASSWORD=""

# Sandbox uses Vercel OIDC automatically in production. These are only needed
# when provisioning Sandboxes from local development or non-Vercel CI.
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_PROJECT_ID=""


# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://next-auth.js.org/configuration/options#secret
AUTH_SECRET='supersecret'

# Preconfigured Github OAuth provider, works out-of-the-box
# @see https://next-auth.js.org/providers/github
AUTH_GITHUB_ID=''
AUTH_GITHUB_SECRET=''

# Used by the Autopilot worker for worksheet analysis.
OPENAI_API_KEY=''

# The URL of your next js app
BETTER_AUTH_URL='http://localhost:3000'
